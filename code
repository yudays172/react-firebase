            Logout
          </button>
        </div>
        <p className="text-gray-600 mb-4">
          <strong className="text-gray-800">App ID:</strong> <span className="font-mono bg-gray-100 px-2 rounded-sm">{appId}</span><br />
          <strong className="text-gray-800">User ID Anda:</strong> <span className="font-mono bg-gray-100 px-2 rounded-sm">{userId}</span><br />
          <strong className="text-gray-800">User ID Admin (demo):</strong> <span className="font-mono bg-gray-100 px-2 rounded-sm">{ADMIN_UID}</span>
        </p>

        <div className="flex border-b border-gray-200 mb-6">
          <button
            className={`py-3 px-6 text-lg font-semibold ${activeTab === 'siswa' ? 'border-b-2 border-blue-600 text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}
