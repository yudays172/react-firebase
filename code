                </tbody>
              </table>
              {students.length === 0 && <p className="text-center py-4 text-gray-500 italic">Belum ada siswa.</p>}
            </div>

            {/* Daftar Mata Pelajaran */}
            <h2 className="text-xl font-semibold text-gray-800 mb-3 mt-8">Daftar Mata Pelajaran ({subjects.length})</h2>
            <div className="overflow-x-auto bg-white rounded-lg shadow-sm border border-gray-200">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-100">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama Mata Pelajaran</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID Firestore</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {subjects.map((mapel) => (
                    <tr key={mapel.id}>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{mapel.nama_mapel}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-mono">{mapel.id}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {subjects.length === 0 && <p className="text-center py-4 text-gray-500 italic">Belum ada mata pelajaran.</p>}
            </div>
          </>
        )}

        {/* Tab Input Nilai */}
        {activeTab === 'nilai' && (
          <>
            <h2 className="text-xl font-semibold text-gray-800 mb-4">Input Nilai PAS Manual</h2>
            <div className="bg-yellow-50 p-6 rounded-lg shadow-sm border border-yellow-200 mb-8">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label htmlFor="select-siswa" className="block text-sm font-medium text-gray-700 mb-1">Pilih Siswa</label>
                  <select
                    id="select-siswa"
                    className="w-full p-2 border border-yellow-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500"
                    value={selectedSiswaId}
                    onChange={(e) => setSelectedSiswaId(e.target.value)}
                  >
                    <option value="">Pilih Siswa (NISN - Nama)</option>
                    {students.map(siswa => (
                      <option key={siswa.id} value={siswa.id}>{siswa.nisn} - {siswa.nama}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label htmlFor="select-mapel" className="block text-sm font-medium text-gray-700 mb-1">Pilih Mata Pelajaran</label>
                  <select
                    id="select-mapel"
                    className="w-full p-2 border border-yellow-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500"
                    value={selectedMapelId}
                    onChange={(e) => setSelectedMapelId(e.target.value)}
                  >
                    <option value="">Pilih Mata Pelajaran</option>
                    {subjects.map(mapel => (
                      <option key={mapel.id} value={mapel.id}>{mapel.nama_mapel}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label htmlFor="manual-nilai" className="block text-sm font-medium text-gray-700 mb-1">Nilai (0-100)</label>
                  <input
                    type="number"
                    step="0.01"
                    id="manual-nilai"
                    className="w-full p-2 border border-yellow-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500"
                    placeholder="Nilai (ex: 85.5)"
                    value={manualNilai}
                    onChange={(e) => setManualNilai(e.target.value)}
                  />
                </div>
                <div>
                  <label htmlFor="semester-manual" className="block text-sm font-medium text-gray-700 mb-1">Semester</label>
                  <input
                    type="text"
                    id="semester-manual"
                    className="w-full p-2 border border-yellow-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500"
                    placeholder="Semester (ex: Ganjil)"
                    value={manualSemester}
                    onChange={(e) => setManualSemester(e.target.value)}
                  />
                </div>
                <div>
                  <label htmlFor="tahun-ajaran-manual" className="block text-sm font-medium text-gray-700 mb-1">Tahun Ajaran</label>
                  <input
                    type="text"
                    id="tahun-ajaran-manual"
                    className="w-full p-2 border border-yellow-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500"
                    placeholder="Tahun Ajaran (ex: 2023/2024)"
                    value={manualTahunAjaran}
                    onChange={(e) => setManualTahunAjaran(e.target.value)}
                  />
                </div>
              </div>
              <button
                onClick={inputNilaiManual}
                className="mt-6 w-full bg-yellow-600 text-white p-3 rounded-md hover:bg-yellow-700 transition duration-300 shadow-md font-semibold"
              >
                Input/Perbarui Nilai
              </button>
            </div>

            {/* Daftar Semua Nilai */}
            <h2 className="text-xl font-semibold text-gray-800 mb-3 mt-8">Daftar Semua Nilai PAS ({grades.length})</h2>
            <div className="overflow-x-auto bg-white rounded-lg shadow-sm border border-gray-200">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-100">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">NISN</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama Siswa</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mata Pelajaran</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nilai</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Semester</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tahun Ajaran</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {grades.map((grade) => (
                    <tr key={grade.id}>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.nisnSiswa}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.namaSiswa}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.namaMapel}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.nilai}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.semester}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{grade.tahun_ajaran}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {grades.length === 0 && <p className="text-center py-4 text-gray-500 italic">Belum ada nilai yang tercatat.</p>}
            </div>
          </>
        )}

        {/* Tab Upload/Export Excel */}
        {activeTab === 'excel' && (
          <>
            <h2 className="text-xl font-semibold text-gray-800 mb-4">Upload Nilai PAS dari Excel</h2>
            <div className="bg-purple-50 p-6 rounded-lg shadow-sm border border-purple-200 mb-8">
              <div className="space-y-3">
                <label htmlFor="excel-file" className="block text-sm font-medium text-gray-700">Pilih file Excel (.xlsx atau .xls):</label>
                <input
                  type="file"
                  id="excel-file"
                  accept=".xlsx, .xls"
                  onChange={handleExcelFileChange}
                  className="w-full text-gray-700 bg-white border border-purple-300 rounded-md p-2 file:mr-4 file:py-2 file:px-4
                             file:rounded-md file:border-0 file:text-sm file:font-semibold
                             file:bg-purple-100 file:text-purple-700 hover:file:bg-purple-200"
                />
                <button
                  onClick={uploadExcel}
                  className="w-full bg-purple-600 text-white p-3 rounded-md hover:bg-purple-700 transition duration-300 shadow-md font-semibold"
                >
                  Upload dan Proses Excel
                </button>
                <p className="text-sm text-gray-600">
                  Pastikan file Excel memiliki header berikut: NISN, Nama Siswa, Kelas, Mata Pelajaran, Nilai, Semester, Tahun Ajaran.
                </p>
                <button
                  onClick={downloadExcelTemplate}
                  className="mt-2 w-full bg-indigo-500 text-white p-2 rounded-md hover:bg-indigo-600 transition duration-300 shadow-md text-sm"
                >
                  Unduh Template Excel
                </button>
              </div>
            </div>

            <h2 className="text-xl font-semibold text-gray-800 mb-4">Export Semua Nilai PAS ke Excel</h2>
            <div className="bg-teal-50 p-6 rounded-lg shadow-sm border border-teal-200">
              <p className="text-sm text-gray-700 mb-4">
                Fungsi ini akan mengunduh semua data nilai yang ada di database ke file Excel.
              </p>
              <button
                onClick={exportAllGrades}
                className="w-full bg-teal-600 text-white p-3 rounded-md hover:bg-teal-700 transition duration-300 shadow-md font-semibold"
              >
                Export Semua Nilai
              </button>
            </div>
          </>
        )}
      </div>
    </div>
  );
};

// --- Main App Component ---
const App = () => {
  const [route, setRoute] = useState(window.location.hash || '#/');

  useEffect(() => {
    const handleHashChange = () => {
      setRoute(window.location.hash);
    };
    window.addEventListener('hashchange', handleHashChange);
    return () => window.removeEventListener('hashchange', handleHashChange);
  }, []);

  const renderContent = () => {
    switch (route) {
      case '#/admin/login':
        return <AdminLogin onLoginSuccess={() => window.location.hash = '#/admin/dashboard'} />;
      case '#/admin/dashboard':
        return <AdminDashboard onLogout={() => {
          getAuth().signOut(); // Sign out from Firebase
          window.location.hash = '#/';
        }} />;
      case '#/':
      default:
        return <StudentView />;
    }
  };

  return (
    <div className="font-sans antialiased text-gray-900 bg-gray-100">
      <style>{`
        /* Tailwind CSS CDN */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        input[type="file"]::file-selector-button {
            cursor: pointer;
        }
      `}</style>
      <AppProvider>
        {renderContent()}
      </AppProvider>
    </div>
  );
};

export default App;
